# ---- Backend settings (copy to backend/.env) ----
APP_ENV=development            # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite by default (file created automatically). 
DATABASE_PATH=data/gameinfo.db

# Steam Web API key (optional). Only needed for IStoreService/GetAppList (full catalog crawl).
# Get one at https://steamcommunity.com/dev/apikey . NEVER expose this to the frontend.
STEAM_API_KEY=
STEAM_API_BASE_URL=https://api.steampowered.com
STEAM_STORE_BASE_URL=https://store.steampowered.com
STEAM_REQUEST_TIMEOUT=15
STEAM_MAX_RETRIES=3
STEAM_MAX_CONCURRENCY=4
STEAM_MIN_INTERVAL_SECONDS=0.25

# Cache TTLs (seconds)
CACHE_TTL_SECONDS=300          # reviews pages, stats
DETAIL_TTL_SECONDS=86400       # game details

# Rate limit for public API (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=120

# Admin token protecting /api/admin/* (leave empty to disable admin endpoints)
ADMIN_TOKEN=
